# Dependencies
node_modules/

# Environment files — never commit secrets
.env
.env.local
.env.production

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Vite / React cache
.vite/

# Coverage reports
coverage/
